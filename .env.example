PORT=3000
HOST=127.0.0.1
AWS_REGION=us-east-1
DYNAMODB_TABLE=btc-guess
# Local DynamoDB only. Omit this for AWS and use the normal AWS credential chain.
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Vite proxies /api to Fastify; local development also accepts localhost alias.
APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
