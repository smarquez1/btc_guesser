PORT=3000
HOST=127.0.0.1
AWS_REGION=us-east-1
DYNAMODB_TABLE=btc-guess
# Local DynamoDB only. Omit this for AWS and use the normal AWS credential chain.
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Use the exact browser origin; Vite proxies /api to Fastify during development.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
