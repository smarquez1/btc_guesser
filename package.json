{
  "name": "btc-guesser",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env --watch --import tsx server/index.ts",
    "build": "pnpm typecheck && vite build",
    "start": "node --env-file=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "db:create": "node --env-file=.env --import tsx scripts/create-table.ts",
    "lint": "biome lint . --error-on-warnings",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "2.1.17",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
