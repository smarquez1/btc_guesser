{
  "name": "btc-guesser",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run '/^dev:(client|server)$/'",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env --watch --import tsx server/index.ts",
    "build": "pnpm typecheck && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env.example --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "node --env-file=.env.example node_modules/@playwright/test/cli.js test",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api && tsc --noEmit",
    "format": "biome format --write .",
    "db:create": "node --env-file=.env --import tsx scripts/create-table.ts",
    "lint": "biome lint . --error-on-warnings",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "svelte": "^5.57.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@7",
    "lefthook": "2.1.17",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.3"
  }
}
