{
  "name": "btc-guesser",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run '/^dev:(client|server)$/'",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env --watch --import tsx server/index.ts",
    "build": "pnpm typecheck && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env.example --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "node --env-file=.env.example node_modules/@playwright/test/cli.js test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "db:create": "node --env-file=.env --import tsx scripts/create-table.ts",
    "lint": "biome lint . --error-on-warnings",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.5",
    "@fastify/view": "^12.0.1",
    "ejs": "^7.0.2",
    "fastify": "^5.12.5",
    "htmx.org": "^2.0.11",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.4",
    "lefthook": "2.1.17",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
