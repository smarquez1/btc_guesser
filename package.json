{
  "name": "btc_guesser",
  "version": "1.0.0",
  "private": true,
  "description": "BTC/USD prediction game",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:setup": "node --env-file-if-exists=.env --import tsx src/server/scripts/db-setup.ts",
    "dev": "concurrently --kill-others -n api,web \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepare": "lefthook install",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "node --env-file-if-exists=.env --import tsx src/server/scripts/db-integration.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.e2e.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "jsdom": "30.0.1",
    "lefthook": "^2.1.17",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
